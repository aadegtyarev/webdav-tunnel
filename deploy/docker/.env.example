# Скопируй в .env (рядом с docker-compose.yml) и заполни.
WEBDAV_URL=https://webdav.yandex.ru
# Логин Яндекса (до @ или полный email):
WEBDAV_LOGIN=your-yandex-login
# ВАЖНО: при 2FA — ПАРОЛЬ ПРИЛОЖЕНИЯ (id.yandex.ru -> Безопасность -> Пароли приложений -> "Файлы (WebDAV)")
WEBDAV_PASSWORD=your-yandex-app-password
