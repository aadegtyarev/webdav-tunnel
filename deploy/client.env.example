# Скопируй в client.env и заполни. Тот же файл подходит для Яндекса и Mail.ru —
# отличаются только WEBDAV_URL и креды.

# --- Яндекс.Диск ---
WEBDAV_URL=https://webdav.yandex.ru
# --- Mail.ru Cloud (раскомментируй вместо строки выше) ---
#WEBDAV_URL=https://webdav.cloud.mail.ru

# Логин (для Яндекса — до @ или полный email; для Mail.ru — полный email):
WEBDAV_LOGIN=your-login
# ВАЖНО: при включённой 2FA нужен ПАРОЛЬ ПРИЛОЖЕНИЯ, а не пароль от аккаунта.
#   Яндекс:  id.yandex.ru -> Безопасность -> Пароли приложений -> "Файлы (WebDAV)"
#   Mail.ru: id.mail.ru   -> Безопасность -> Пароли для внешних приложений
WEBDAV_PASSWORD=your-app-password

# --- Троттлинг (опционально, ставить ОДИНАКОВО на сервере и всех клиентах) ---
# Профиль для 2-3 своих устройств на одном аккаунте Яндекса — не ловит 429,
# когда несколько устройств активны разом:
TUNING_ARGS=-puts 3 -read-min 1 -read-max 3 -poll-min 400ms -poll-max 2s
# Одно устройство и хочется максимум скорости — оставь пусто (дефолты Яндекса):
#TUNING_ARGS=
# Mail.ru (жёстче лимиты, крупнее чанки):
#TUNING_ARGS=-chunk-size 524287 -puts 3 -read-min 1 -read-max 4 -poll-min 500ms -poll-max 2s
